# Copy to .env on the VPS (never commit real .env)

# SQLite — one app instance only (fine for a single VPS)
DATABASE_URL="file:./prod.db"

# Must match exactly what users open in the browser (no trailing slash)
# Linux + nginx on port 80:
NEXTAUTH_URL="http://YOUR_VPS_IP"
# Windows (app on port 3000 directly):
# NEXTAUTH_URL="http://YOUR_VPS_IP:3000"
# With nginx + domain + HTTPS:
# NEXTAUTH_URL="https://sims.yourdomain.edu"

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-long-random-secret"

# Optional: bind Next directly (nginx usually proxies to 3000)
PORT=3000
