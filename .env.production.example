# Vercel + Neon + Cloudinary (never commit real secrets)

# Neon pooled (serverless / Vercel runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Neon direct (prisma db push / migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Must match the public site URL (no trailing slash)
NEXTAUTH_URL="https://YOUR-PROJECT.vercel.app"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="assets/SIMS"
